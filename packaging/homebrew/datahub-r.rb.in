class DatahubR < Formula
  desc "Portable launcher for the CCHMC datahub-r environment"
  homepage "https://github.com/cole-brokamp/datahub-r"
  version "@VERSION@"
  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/cole-brokamp/datahub-r/releases/download/v@VERSION@/datahub-r-aarch64-apple-darwin.tar.gz"
      sha256 "@MACOS_ARM_SHA256@"
    else
      url "https://github.com/cole-brokamp/datahub-r/releases/download/v@VERSION@/datahub-r-x86_64-apple-darwin.tar.gz"
      sha256 "@MACOS_INTEL_SHA256@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/cole-brokamp/datahub-r/releases/download/v@VERSION@/datahub-r-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_ARM_SHA256@"
    else
      url "https://github.com/cole-brokamp/datahub-r/releases/download/v@VERSION@/datahub-r-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_INTEL_SHA256@"
    end
  end

  def install
    bin.install "datahub-r"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/datahub-r version")
  end
end
